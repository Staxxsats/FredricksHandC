# Frederick's Heating & Cooling: environment template. NO real secrets in this file.
# Copy to .env.local for development.

# --- Database ---
# Leave empty in development to use the embedded local Postgres (PGlite) stored in ./.data/pglite.
# In staging/production, set a managed Postgres URL (e.g. Neon or Supabase free tier).
DATABASE_URL=

# --- Auth ---
# 32+ random characters. Used to sign nothing secret-bearing today but reserved for session hardening.
SESSION_SECRET=
# Used only by `npm run db:create-owner` to create the first owner_admin login.
OWNER_EMAIL=
OWNER_PASSWORD=

# --- Spam / privacy ---
# Random string used to hash IP addresses for rate limiting (raw IPs are never stored).
IP_HASH_SALT=

# --- Site ---
# Public origin used for canonical URLs and sitemap. Set once the domain is owned and verified.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Integrations (all disabled until approved; the app fails closed) ---
EMAIL_PROVIDER=            # e.g. resend | postmark (not chosen yet)
EMAIL_API_KEY=
EMAIL_FROM=
LEAD_ALERT_EMAIL=          # internal inbox for new-lead alerts (no customer PII in alert body)
SMS_PROVIDER=              # not chosen; disabled
CALENDAR_PROVIDER=         # not chosen; appointment times are requests only
PAYMENT_PROVIDER=          # not chosen; disabled
AI_PROVIDER=               # not chosen; disabled
ANALYTICS_PROVIDER=        # not chosen; events are dropped server-side
